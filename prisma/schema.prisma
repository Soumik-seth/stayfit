generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  password     String
  phoneNumber  String?
  dateOfBirth  DateTime
  weight       Float
  height       Float
  gender       String
  bodyFat      Float?
  muscleMass   Float?
  visceralFat  Int?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weightHistory     WeightHistory[]
  subscriptions     Subscription[]
  dietPlans         DietPlan[]
  uploadedImages    UserImage[]
  videoCallRequests VideoCallRequest[]
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model WeightHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  weight    Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  serviceType   String
  planName      String
  durationDays  Int
  price         Float
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE")
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([serviceType])
}

model DietPlan {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserImage {
  id         Int      @id @default(autoincrement())
  userId     Int
  imageUrl   String
  imageType  String
  uploadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VideoCallRequest {
  id           Int      @id @default(autoincrement())
  userId       Int
  requestedAt  DateTime @default(now())
  status       String   @default("PENDING")
  adminMessage String?
  callDate     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Plan {
  id           Int      @id @default(autoincrement())
  serviceType  String
  planName     String
  durationDays Int
  price        Float
  features     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([serviceType])
  @@index([isActive])
}